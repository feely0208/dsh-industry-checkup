{
  "name": "@deepwhale-cn/dsh-industry-checkup",
  "version": "0.2.0",
  "description": "深鲸行业合规体检：一个面板管六个行业（医疗/财税/招聘/制造/房产/档案），按法规出处出命中与修复建议",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "compliance",
    "industry",
    "合规",
    "体检"
  ],
  "files": [
    "lib",
    "bin",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-industry-checkup": "./bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1",
    "@deepwhale-cn/dsh-industry-medical": "^0.1.1",
    "@deepwhale-cn/dsh-industry-tax": "^0.1.0",
    "@deepwhale-cn/dsh-industry-hr": "^0.1.0",
    "@deepwhale-cn/dsh-industry-manufacturing": "^0.1.0",
    "@deepwhale-cn/dsh-industry-realestate": "^0.1.0",
    "@deepwhale-cn/dsh-industry-archive": "^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-industry-checkup.git"
  },
  "homepage": "https://www.deepwhale.org.cn/skills.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-industry-checkup/issues"
  },
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>"
}
